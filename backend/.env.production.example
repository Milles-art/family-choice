# PRODUCTION TEMPLATE: supply credentials privately; never commit a populated .env.
APP_NAME="FAMILY CHOICE SUPERMARKET"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://familychoiceminimarket.co.tz
APP_TIMEZONE=Africa/Dar_es_Salaam
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="FAMILY CHOICE SUPERMARKET"
# Empty trusts no proxy. Use exact proxy IPs/CIDRs, comma-separated.
TRUSTED_PROXIES=
ADMIN_ALLOWED_IPS=
STORE_CSP_MODE=report-only
# Enable only after real-domain HTTPS has been confirmed.
STORE_HSTS=false
STORE_CURRENCY=TZS
STORE_TAX_RATE=0.18
STORE_DELIVERY_CENTS=500000
STORE_FREE_DELIVERY_CENTS=7500000
STORE_MAX_OPEN_ORDERS=3
STORE_UNPAID_CANCEL_MINUTES=45
# Disabled by default; enabling also expires unconfirmed cash/manual orders.
STORE_UNCONFIRMED_ORDER_HOURS=0
STORE_MOBILE_MONEY_ENABLED=false
STORE_MOBILE_MONEY_INSTRUCTIONS=
SELCOM_ENABLED=false
SELCOM_BASE_URL=
SELCOM_VENDOR=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_RECONCILE_HOURS=48
